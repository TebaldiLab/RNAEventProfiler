Package: RNAEventProfiler
Title: Multi-Resolution, Replicate-Aware Differential Analysis of RNA Events
Version: 0.1.0
Authors@R: c(
    person(given = "C.", family = "Ramirez", role = c("aut", "cre"), email = "tua.email@example.com"),
